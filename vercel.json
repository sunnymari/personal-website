{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/carbonbench/:path*",
      "destination": "/api/carbonbench-proxy?path=:path*"
    },
    {
      "source": "/actuator-diagnostics",
      "destination": "/actuator-diagnostics.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/growth",
      "destination": "/growth.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/dream-companies",
      "destination": "/dream-companies.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/data-center-watch",
      "destination": "/data-center-watch.html"
    },
    {
      "source": "/art",
      "destination": "/art.html"
    },
    {
      "source": "/sprout",
      "destination": "/data-center-watch.html"
    }
  ],
  "redirects": [
    {
      "source": "/modeling",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/modeling.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work-with-me.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/chibi",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/chibi.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pageant",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pageant.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lock-in",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lock-in.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/reading",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/reading.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/waitlist.js": {
      "maxDuration": 10
    },
    "api/carbonbench-proxy.js": {
      "maxDuration": 15
    },
    "api/sprout-logs.js": {
      "maxDuration": 10
    },
    "api/sprout-grid.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
